{
  "name": "hiringarrow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "migrate": "node scripts/migrate.js",
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "dev:worker": "node --watch --env-file-if-exists=.env src/worker.js",
    "smoke": "node scripts/smoke.js",
    "smoke:ui": "node scripts/ui-smoke.mjs",
    "mock-ai": "node scripts/mock-ai.mjs",
    "test:failover": "MAIL_DRIVER=smtp SMTP_URL=smtp://127.0.0.1:9 SMTP_URL_FALLBACK=log node scripts/failover-test.mjs",
    "test:llm": "AI_BASE_URL=http://127.0.0.1:4010/v1 node scripts/llm-test.mjs",
    "test:headers": "node scripts/headers-test.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.7.0",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "html-to-text": "^10.0.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.1",
    "sns-validator": "^0.3.5"
  },
  "devDependencies": {
    "jsdom": "^26.0.0"
  }
}
