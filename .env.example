# ---- Local development (docker compose) ----
NODE_ENV=development
BASE_URL=http://localhost:3000
MAIL_DRIVER=smtp
AUTO_APPROVE=true            # dev only. In production leave false and approve tenants via /admin
SNS_VERIFY=true

# ---- Free email sending (Brevo free plan: 300 emails a day, no credit card) ----
# Create the account, then Settings > SMTP & API > make an SMTP key. If your login email has an @, write it as %40.
# MAIL_DRIVER=smtp
# SMTP_URL=smtp://you%40example.com:YOUR_SMTP_KEY@smtp-relay.brevo.com:587
# SEND_RATE_PER_SEC=2
# BREVO_WEBHOOK_SECRET=<long random string>   # then in Brevo add webhook  https://YOUR_HOST/webhooks/brevo?token=<that string>
# Then set the tenant's daily cap to 300 or less with the admin approve call (see README).

# ---- Production: change ALL of these ----
# NODE_ENV=production
# BASE_URL=https://app.yourdomain.com
# JWT_SECRET=<64 random chars>         (openssl rand -hex 32)
# SIGN_SECRET=<64 random chars>        (different from JWT_SECRET)
# ADMIN_KEY=<long random string>
# AUTO_APPROVE=false
# REQUIRE_DOMAIN_VERIFIED=true         (SPF + DKIM must pass before a domain can send; also enables warm-up caps)
# VERIFY_MX=true                       (reject addresses whose domain has no mail server)
# SMTP_URL=smtps://SES_SMTP_USER:SES_SMTP_PASSWORD@email-smtp.ap-south-1.amazonaws.com:465
# SYSTEM_FROM="Dakghar <no-reply@mail.yourdomain.com>"
# SEND_RATE_PER_SEC=14                 (stay under your SES sending rate)

# ---- Second email provider (automatic failover) ----
# SMTP_URL_FALLBACK=smtps://USER:PASS@smtp.sendgrid.net:465   (used when the main provider is down or throttling)
# Bounce/complaint tracking for the fallback provider needs its own webhook; the main provider's webhook only knows its own ids.

# ---- Writing help ----
# Free and built in. Nothing to set. Optional, still free: connect a local model such as Ollama for richer writing:
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1

# ---- Razorpay (subscriptions) ----
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
